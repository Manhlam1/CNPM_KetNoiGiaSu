# ===== TutorHub backend =====
PORT=9090
BACKEND_PUBLIC_URL=http://localhost:9090
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tutorhub
DB_PASSWORD=tutorhub
DB_NAME=tutorhub
# Tự tạo/cập nhật bảng theo entity (giống ddl-auto=update)
DB_SYNC=true

# JWT - BẮT BUỘC đổi khi chạy thật (chuỗi dài, ngẫu nhiên)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Email: console = không gửi thật, xem OTP ở trang /dev/mailbox; smtp = gửi qua SMTP (vd. Mailtrap)
MAIL_TRANSPORT=console
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TutorHub <no-reply@tutorhub.local>

# Thanh toán: mock (giả lập, chạy local không cần gì thêm) | vnpay (sandbox)
PAYMENT_PROVIDER=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Return URL VNPay gọi về (khi test local nên dùng URL ngrok trỏ tới backend)
VNPAY_RETURN_URL=http://localhost:9090/api/payments/vnpay/return
# true: xử lý kết quả ngay ở Return URL (khi IPN không gọi được về máy local). Có kiểm tra chữ ký + idempotent.
VNPAY_PROCESS_ON_RETURN=true

# Chế độ demo: bật công cụ tua thời gian + hộp thư dev
DEMO_MODE=true
# Tự nạp dữ liệu mẫu khi database trống
SEED_ON_START=true
JOBS_ENABLED=true
UPLOAD_DIR=uploads
