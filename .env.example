# ===== Biến môi trường cho docker compose =====
# Copy thành .env rồi đổi các giá trị bí mật. KHÔNG commit file .env.
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=tutorhub
DB_USER=tutorhub
DB_PASSWORD=change-me-db
DB_SYNC=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# console: không gửi mail thật, xem OTP ở http://localhost:5173/dev/mailbox
MAIL_TRANSPORT=console
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TutorHub <no-reply@tutorhub.local>

# mock | vnpay
PAYMENT_PROVIDER=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
BACKEND_PUBLIC_URL=http://localhost:9090
VNPAY_RETURN_URL=http://localhost:9090/api/payments/vnpay/return
VNPAY_PROCESS_ON_RETURN=true

DEMO_MODE=true
SEED_ON_START=true
JOBS_ENABLED=true
